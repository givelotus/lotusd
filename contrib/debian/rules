#!/usr/bin/make -f
# -*- mode: makefile; coding: utf-8 -*-

# Ubuntu Jammy enables LTO by default. It was disabled because it produced a
# broken GUI binary on amd64; the setting is kept so the daemon build does not
# change.
export DEB_BUILD_MAINT_OPTIONS = optimize=-lto

%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=_build

# -DUSE_LINKER= disables the use of the gold linker in favor of the default
# linker. ld.gold is deprecated and no longer available by default since Ubuntu
# 26.04 (resolute).
override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=$$(pwd)/debian/tmp \
		-DCLIENT_VERSION_IS_RELEASE=ON \
		-DUSE_JEMALLOC=OFF \
		-DUSE_LINKER= \
		-DBUILD_LIBBITCOINCONSENSUS=OFF \
		-DBUILD_SEEDER=OFF \
		-DBUILD_IGUANA=OFF

override_dh_auto_test:
	ninja -C _build check

override_dh_auto_install:
	ninja -C _build install/strip
	DESTDIR= ninja -C _build install-manpages

# Skip the dwz step since the files are stripped already.
# https://manpages.debian.org/testing/debhelper/dh_dwz.1.en.html
override_dh_dwz: ;

# Enforce dh_missing to issue warnings when files are present but not installed.
# Note that this is the default with compat level 12.
override_dh_missing:
	dh_missing --list-missing
