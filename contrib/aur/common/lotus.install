_bc_user=lotus
_bc_group=lotus

post_install() {
  _mkuser
  chown -R $_bc_user:$_bc_group /etc/lotus /srv/lotus /run/lotus
  printf "%b\n" "$lotus"
}

post_upgrade() {
  _mkuser
  chown -R $_bc_user:$_bc_group /etc/lotus /srv/lotus /run/lotus
  printf "%b\n" "$lotus"
}

post_remove() {
  : # Preserve the service account and chain data on uninstall
}

_mkuser() {
  getent passwd $_bc_user &>/dev/null || {
    echo -n "Creating lotus user... "
    grep -E "^$_bc_group:" /etc/group >/dev/null || groupadd $_bc_group
    useradd -m -d /etc/lotus -g $_bc_group -s /usr/bin/nologin $_bc_user 2>/dev/null
    echo "done"
  }
}

_rmuser() {
  echo -n "Removing lotus user... "
  userdel $_bc_user 2>/dev/null
  echo "done"
}

read -d '' lotus <<'EOI'

Lotus
_____

To start Lotus:

$ sudo systemctl start lotus

RPC uses the daemon's automatically generated authentication cookie.
Run the CLI as the service user with the same config and data directory:

$ sudo -u lotus /usr/bin/lotus-cli -conf=/etc/lotus/lotus.conf -datadir=/srv/lotus getmininginfo

Config:        /etc/lotus/lotus.conf
Blockchain:    /srv/lotus
Cookie:        /srv/lotus/.cookie (private to the service account)
Documentation: /usr/share/doc/lotus
EOI
