# Requires /usr/bin/python3.13 (PyO3 0.23); do not substitute newer Python.
# Maintainer: Josh Ellithorpe <quest@mac.com>

pkgname=lotus-qt
pkgver=11.6.1
pkgrel=1
pkgdesc="Lotus with lotusd, lotus-cli, lotus-tx, lotus-seeder and lotus-qt"
arch=('x86_64')
url="https://givelotus.org"
depends=('boost-libs' 'libevent' 'desktop-file-utils' 'qt5-base' 'protobuf' 'openssl' 'nng' 'utf8proc' 'sqlite' 'qrencode' 'jemalloc')
makedepends=('protobuf' 'flatbuffers' 'rustup' 'clang' 'curl' 'cmake' 'ninja' 'boost' 'qt5-tools' 'python313' 'help2man' 'xorg-server-xvfb')
license=('MIT')
source=(https://github.com/givelotus/lotus/releases/download/v$pkgver/lotus-v$pkgver-source.tar.gz)
sha256sums=('SKIP')

prepare() {
  curl --fail --location --proto '=https' --tlsv1.2 \
    https://github.com/givelotus/lotus/releases/download/v$pkgver/SHA256SUMS -o SHA256SUMS
  grep -E "^[0-9a-f]{64}  lotus-v${pkgver//./\.}-source\.tar\.gz$" SHA256SUMS | sha256sum --check --strict -
  rustup toolchain install 1.93.0 --profile minimal --component clippy
}

backup=('etc/lotus/lotus.conf'
        'etc/logrotate.d/lotus')
provides=('lotus-cli' 'lotus-daemon' 'lotus-tx' 'lotus-qt' 'lotus-seeder' 'lotus-wallet')
conflicts=('lotus-cli' 'lotus-daemon' 'lotus-tx' 'lotus-qt' 'lotus-seeder' 'lotus-wallet')
install=../common/lotus.install

build() {
  cd "$srcdir/lotus-v$pkgver"

  msg2 'Building...'
  mkdir -p build
  pushd build

  cmake -GNinja .. \
    -DBUILD_CHRONIK=ON \
    -DRust_TOOLCHAIN=1.93.0 \
    -DPython_EXECUTABLE=/usr/bin/python3.13 \
    -DBUILD_BITCOIN_ZMQ=OFF \
    -DENABLE_UPNP=OFF \
    -DENABLE_NATPMP=OFF \
    -DENABLE_CLANG_TIDY=OFF \
    -DCLIENT_VERSION_IS_RELEASE=ON \
    -DENABLE_REDUCE_EXPORTS=ON \
    -DENABLE_STATIC_LIBSTDCXX=ON \
    -DCMAKE_INSTALL_PREFIX=$pkgdir/usr

  PYO3_PYTHON=/usr/bin/python3.13 ninja
  popd
}

check() {
  cd "$srcdir/lotus-v$pkgver/build"

  msg2 'Testing...'
  PYO3_PYTHON=/usr/bin/python3.13 ninja check
}

package() {
  cd "$srcdir/lotus-v$pkgver"

  msg2 'Installing desktop shortcut...'
  install -Dm644 contrib/debian/lotus-qt.desktop \
    "$pkgdir"/usr/share/applications/lotus.desktop
  install -Dm644 share/pixmaps/lotus128.png \
    "$pkgdir"/usr/share/pixmaps/lotus128.png

  msg2 'Installing license...'
  install -Dm 644 COPYING -t "$pkgdir/usr/share/licenses/${pkgname}"

  msg2 'Installing examples...'
  install -Dm644 "contrib/debian/examples/lotus.conf" \
    -t "$pkgdir/usr/share/doc/lotus/examples"

  msg2 'Installing documentation...'
  install -dm 755 "$pkgdir/usr/share/doc/lotus"
  for _doc in \
    $(find doc -maxdepth 1 -type f -name "*.md" -printf '%f\n') \
    release-notes; do
      cp -dpr --no-preserve=ownership "doc/$_doc" \
        "$pkgdir/usr/share/doc/lotus/$_doc"
  done

  msg2 'Installing essential directories'
  install -dm 700 "$pkgdir/etc/lotus"
  install -dm 755 "$pkgdir/srv/lotus"
  install -dm 755 "$pkgdir/run/lotus"

  pushd build
  msg2 'Installing executables...'
  ninja install/strip

  msg2 'Installing man pages...'
  xvfb-run ninja install-manpages
  popd

  msg2 'Installing lotus.conf...'
  install -Dm 600 "contrib/aur/common/lotus.conf" -t "$pkgdir/etc/lotus"

  msg2 'Installing lotusd.service...'
  install -Dm 644 "contrib/aur/common/lotus.service" -t "$pkgdir/usr/lib/systemd/system"
  install -Dm 644 "contrib/aur/common/lotus-reindex.service" \
    -t "$pkgdir/usr/lib/systemd/system"

  msg2 'Installing lotus.logrotate...'
  install -Dm 644 "contrib/aur/common/lotus.logrotate" "$pkgdir/etc/logrotate.d/lotus"

  msg2 'Installing bash completion...'
  for _compl in lotus-cli lotus-tx lotusd; do
    install -Dm 644 "contrib/${_compl}.bash-completion" \
      "$pkgdir/usr/share/bash-completion/completions/$_compl"
  done
}
